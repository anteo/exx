// From zxevo-sdk lib/common/src/console/z80/zx__console_newline.asm
// and zx__console_advance.asm. The row and column counts are nonzero.

zx__console_newline(cursor → BC, rows → D) → (BC) clobbers(A, F) {
    (column, row) → (C, B)
    column = 0
    A = row
    A += 1
    if (A >= rows) {
        A = rows
        A -= 1
    }
    row = A
    return cursor
}

zx__console_advance(cursor → BC, geometry → DE) → (BC) clobbers(A, F) {
    (column, columns, rows) → (C, E, D)
    column += 1
    A = column
    if (A < columns) return cursor
    return zx__console_newline(cursor, rows)
}
