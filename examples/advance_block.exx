// Move by at most limit bytes. The caller supplies limit <= remaining.
// Return the distance in A, the new cursor in HL and the new count in DE.
(A, HL, DE) advance_block(requested → B, limit → C, cursor → HL, remaining → DE) clobbers(B, F) {
    A = requested
    if (A > limit) A = limit
    requested = A

    while (A) {
        ++cursor
        --remaining
        A--
    }

    return (requested, cursor, remaining)
}

// Move by at most four bytes within an eight-byte block.
(A, HL, DE) advance_block_demo(cursor → HL) clobbers(B, C, F) {
    B = 4
    C = 8
    DE = 8
    (A, HL, DE) = advance_block(B, C, cursor, DE)
    return (A, HL, DE)
}
