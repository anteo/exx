// Copy count bytes, preserving the caller's pointers, count and flags.
// As with LDIR, a zero count copies 65536 bytes.
copy_bytes(source → HL, destination → DE, count → BC) {
    keep(AF, source, destination, count) {
        ldir(destination, source, count)
    }
}

// Install a new pointer in the alternate HL, preserving the active bank.
set_alt_pointer(pointer → HL) clobbers(HL_ALT) {
    push(pointer)
    exx()
    pop(HL)
    exx()
}

// Replace the port byte and return the value read before the write.
A replace_port_byte(port → BC, value → E) clobbers(S, Z, HF, PV, N) {
    A = in(port)
    out(port, value)
    return A
}
